APP_ENV=development
LOG_LEVEL=debug
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=2m
FRONTEND_ORIGIN=http://localhost:5173

MYSQL_DSN=whatsnext:whatsnext_dev@tcp(localhost:3307)/whatsnext?charset=utf8mb4&parseTime=true&loc=UTC
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=whatsnext
MINIO_SECRET_KEY=whatsnext_minio_dev
MINIO_BUCKET=whatsnext-materials
MINIO_SECURE=false
MAX_UPLOAD_BYTES=104857600
JOB_QUEUE_NAME=whatsnext:jobs:material
WORKER_POLL_DELAY=5s
MAX_PDF_PAGES=500
PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGES=chi_sim+eng
PDF_OCR_DPI=200
PDF_OCR_WORKERS=4
PDF_OCR_PAGE_TIMEOUT=45s
CHUNK_TARGET_RUNES=1200
CHUNK_OVERLAP_RUNES=120
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=material_chunks
QDRANT_TIMEOUT=10s

JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# 阿里云百炼北京地域，WorkspaceId 需替换为真实值。
BAILIAN_BASE_URL=https://WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
AI_GENERATION_MODEL=qwen3.7-plus
AI_CHEAP_MODEL=qwen3.6-flash
AI_GENERATION_TIMEOUT=5m
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_BATCH_SIZE=10
AI_EMBEDDING_TIMEOUT=30s
AI_MOCK_EMBEDDING=true
AI_MOCK_GENERATION=true
